APP_NAME=Laravel

# AICRM Mock/Sandbox settings. Production credentials belong only in the Live block.
AICRM_MODE=mock
AICRM_API_URL=
AICRM_API_KEY=
AICRM_SHIPPING_PROVIDER_ID=
AICRM_TENANT_HEADER=
AICRM_SHOP_TENANTS='{}'
AICRM_CREDENTIAL_TENANT=
# Backend-only JSON: tenant UUID -> {"api_key":"...","shipping_provider_id":123}
AICRM_TENANT_CREDENTIALS='{}'
AICRM_SANDBOX_ENABLED=false
AICRM_SANDBOX_HOSTS=127.0.0.1,localhost,::1
AICRM_TIMEOUT=10
AICRM_CONNECT_TIMEOUT=3
AICRM_MOCK_SCENARIO=success

# Live is separate. Fill ONLY from the verified B2B contract; never browser cookies.
AICRM_LIVE_ENABLED=false
AICRM_LIVE_CREATION_ENABLED=false
AICRM_LIVE_CONTRACT_CONFIRMED=false
AICRM_LIVE_API_URL=
AICRM_LIVE_HOSTS=
AICRM_LIVE_API_KEY=
AICRM_LIVE_TENANT_MODE=api_key
AICRM_LIVE_TENANT_HEADER=
AICRM_LIVE_CREDENTIAL_TENANT=
AICRM_LIVE_SHOP_TENANTS='{}'
AICRM_LIVE_TENANT_CREDENTIALS='{}'
AICRM_LIVE_SHIPPING_PROVIDER_ID=
AICRM_LIVE_AUTH_CHECK_PATH=
AICRM_LIVE_PROVIDERS_PATH=/api/v1/shipping-providers
AICRM_LIVE_ORDERS_PATH=/api/v1/orders
AICRM_LIVE_ORDER_DETAIL_PATH=/api/v1/orders/{id}
AICRM_LIVE_RECONCILIATION_CONFIRMED=false
AICRM_LIVE_APPROVED_ORDER_ID=
AICRM_LIVE_ACTIVATED_AT=
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

AUTO_RECLAIM_CUSTOMER_CARE_ENABLED=false
AUTO_RECLAIM_CUSTOMER_CARE_LIMIT=500

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PANCAKE_API_V1=https://pos.pages.fm/api/v1/
API_KEY_FROM_PANCAKE_WEB=

HUONG_CHAT_API_URL=http://127.0.0.1:8001/api
HUONG_CHAT_API_KEY=
HUONG_CHAT_API_TIMEOUT=10

# Real AICRM loopback GET checks only; the key stays in a private ignored file.
AICRM_LOCAL_ENABLED=false
AICRM_LOCAL_API_URL=http://127.0.0.1:8185
AICRM_LOCAL_API_KEY_FILE=
AICRM_LOCAL_CREDENTIAL_TENANT=
AICRM_LOCAL_SHOP_TENANTS='{}'
AICRM_LOCAL_EXPECTED_PROVIDER_ID=
